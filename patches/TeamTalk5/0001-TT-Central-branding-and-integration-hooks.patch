From: TT Central contributors
Subject: [PATCH] qtTeamTalk: TT Central branding and integration hooks

- appinfo.h: when built as TT Central (TTCENTRAL defined), use TT Central's
  name, title, website and settings location (TTCentral.ini), so it never
  shares or overwrites the official TeamTalk client's settings. BearWare's web
  services (server list, join codes) still see the client as "TeamTalk5".
- mainwindow.cpp: call TT Central's install() hook after the UI is set up and
  forward the client's own TeamTalk events to it; do not offer TeamTalk
  updates from BearWare's update channel (the BearWare registration URL from
  that reply is still used).
- CMakeLists.txt: compile TT Central's integration sources into the client,
  link its libraries, and name the executable TTCentral.

Without TTCENTRAL defined, the client builds exactly as upstream.

Upstream: BearWare/TeamTalk5 tag v5.23 (a0d26fd). License: GPLv3 (as upstream).
---
diff --git a/Client/qtTeamTalk/CMakeLists.txt b/Client/qtTeamTalk/CMakeLists.txt
index 20ec78a..b17e3ee 100644
--- a/Client/qtTeamTalk/CMakeLists.txt
+++ b/Client/qtTeamTalk/CMakeLists.txt
@@ -134,6 +134,11 @@ if (Qt5_FOUND OR Qt6_FOUND)
     resources.qrc mainwindow.rc
     )
 
+  # TT Central: add its integration sources to the client.
+  if (TTCENTRAL_CLIENT_SOURCES)
+    list (APPEND QTTEAMTALK_SOURCES ${TTCENTRAL_CLIENT_SOURCES})
+  endif()
+
 
   if (Qt6_FOUND)
     set (TEAMTALK_LINK_FLAGS Qt6::Widgets Qt6::Xml Qt6::Network Qt6::Multimedia Qt6::TextToSpeech)
@@ -226,6 +231,14 @@ if (Qt5_FOUND OR Qt6_FOUND)
       target_link_libraries (${TEAMTALK_TARGET} WinToast)
     endif()
 
+    # TT Central: link its libraries, enable its hooks, name the executable.
+    if (TTCENTRAL_CLIENT_SOURCES)
+      target_link_libraries (${TEAMTALK_TARGET} ${TTCENTRAL_CLIENT_LIBRARIES})
+      target_compile_definitions (${TEAMTALK_TARGET} PRIVATE TTCENTRAL ${TTCENTRAL_CLIENT_DEFINITIONS})
+      target_include_directories (${TEAMTALK_TARGET} PRIVATE ${TTCENTRAL_CLIENT_INCLUDE_DIRS})
+      set_target_properties (${TEAMTALK_TARGET} PROPERTIES OUTPUT_NAME TTCentral)
+    endif()
+
     if (BUILD_TEAMTALK_LIBRARY_DLL)
       target_include_directories (${TEAMTALK_TARGET} PUBLIC ./)
       target_link_libraries (${TEAMTALK_TARGET} ${TEAMTALK_LINK_FLAGS} TeamTalk5DLL)
diff --git a/Client/qtTeamTalk/appinfo.h b/Client/qtTeamTalk/appinfo.h
index db05adb..a923131 100644
--- a/Client/qtTeamTalk/appinfo.h
+++ b/Client/qtTeamTalk/appinfo.h
@@ -25,7 +25,11 @@
 #include <QIcon>
 #include <QString>
 
+#if defined(TTCENTRAL)
+#define COMPANYNAME         "TTCentral"
+#else
 #define COMPANYNAME         "BearWare.dk"
+#endif
 #define APPVERSION_SHORT    "5.23.0"
 #define APPVERSION_POSTFIX  ""
 #define APPVERSION          "5.23" APPVERSION_POSTFIX
@@ -34,10 +38,21 @@
 #define APPTRAYICON         QString::fromUtf8(":/images/images/teamtalky.png")
 #define APPTRAYICON_CON     QString::fromUtf8(":/images/images/teamtalk.png")
 #define APPTRAYICON_ACTIVE  QString::fromUtf8(":/images/images/teamtalkg.png")
+#if defined(TTCENTRAL)
+#define APPWEBSITE          "https://github.com/donovanmalisch23-alt/TT_Central"
+#else
 #define APPWEBSITE          "http://www.bearware.dk"
+#endif
 
+#if defined(TTCENTRAL)
+#define APPTITLE            "TT Central " TTC_VERSION " (TeamTalk " APPVERSION ")"
+#define APPNAME_SHORT       "TTCentral"
+#else
 #define APPTITLE            "TeamTalk v. " APPVERSION
 #define APPNAME_SHORT       "TeamTalk5"
+#endif
+/* Identifies the client to BearWare.dk's web services (server list, join codes). */
+#define APPNAME_UPSTREAM    "TeamTalk5"
 
 #define APPINIFILE          (QApplication::applicationName() + ".ini")
 
@@ -66,11 +81,11 @@
 #define OSTYPE "Linux"
 #endif
 
-#define URL_FREESERVER(official, pub, unofficial) QString("http://www.bearware.dk/teamtalk/tt5servers.php?client=" APPNAME_SHORT "&version=" APPVERSION_SHORT "&dllversion=" TEAMTALK_VERSION "&os=" OSTYPE "&official=%1&unofficial=%2").arg(official ? "1" : "0").arg(unofficial ? "1" : "0")
-#define URL_PUBLISHSERVER(uid, token) QString("https://www.bearware.dk/teamtalk/tt5servers.php?client=" APPNAME_SHORT "&version=" APPVERSION_SHORT "&dllversion=" TEAMTALK_VERSION "&os=" OSTYPE "&action=publish&username=%1&token=%2").arg(uid).arg(token)
-#define URL_PUBLISHSERVER_JOINCODE(uid, token) QString("https://www.bearware.dk/teamtalk/tt5servers.php?client=" APPNAME_SHORT "&version=" APPVERSION_SHORT "&dllversion=" TEAMTALK_VERSION "&os=" OSTYPE "&action=publish&username=%1&token=%2&joincode=1").arg(uid).arg(token)
-#define URL_SERVER_JOINCODE(joincode) QString("https://www.bearware.dk/teamtalk/tt5servers.php?client=" APPNAME_SHORT "&version=" APPVERSION_SHORT "&dllversion=" TEAMTALK_VERSION "&os=" OSTYPE "&action=joincode&joincode=%3").arg(joincode)
-#define URL_APPUPDATE(beta)       QString("http://www.bearware.dk/teamtalk/tt5update.php?client=" APPNAME_SHORT "&version=" APPVERSION_SHORT "&dllversion=" TEAMTALK_VERSION "&os=" OSTYPE "&beta=%1").arg(beta ? "1" : "0")
+#define URL_FREESERVER(official, pub, unofficial) QString("http://www.bearware.dk/teamtalk/tt5servers.php?client=" APPNAME_UPSTREAM "&version=" APPVERSION_SHORT "&dllversion=" TEAMTALK_VERSION "&os=" OSTYPE "&official=%1&unofficial=%2").arg(official ? "1" : "0").arg(unofficial ? "1" : "0")
+#define URL_PUBLISHSERVER(uid, token) QString("https://www.bearware.dk/teamtalk/tt5servers.php?client=" APPNAME_UPSTREAM "&version=" APPVERSION_SHORT "&dllversion=" TEAMTALK_VERSION "&os=" OSTYPE "&action=publish&username=%1&token=%2").arg(uid).arg(token)
+#define URL_PUBLISHSERVER_JOINCODE(uid, token) QString("https://www.bearware.dk/teamtalk/tt5servers.php?client=" APPNAME_UPSTREAM "&version=" APPVERSION_SHORT "&dllversion=" TEAMTALK_VERSION "&os=" OSTYPE "&action=publish&username=%1&token=%2&joincode=1").arg(uid).arg(token)
+#define URL_SERVER_JOINCODE(joincode) QString("https://www.bearware.dk/teamtalk/tt5servers.php?client=" APPNAME_UPSTREAM "&version=" APPVERSION_SHORT "&dllversion=" TEAMTALK_VERSION "&os=" OSTYPE "&action=joincode&joincode=%3").arg(joincode)
+#define URL_APPUPDATE(beta)       QString("http://www.bearware.dk/teamtalk/tt5update.php?client=" APPNAME_UPSTREAM "&version=" APPVERSION_SHORT "&dllversion=" TEAMTALK_VERSION "&os=" OSTYPE "&beta=%1").arg(beta ? "1" : "0")
 
 #define TTFILE_EXT          ".tt"
 #define TTFILE_ROOT         "teamtalk"
diff --git a/Client/qtTeamTalk/mainwindow.cpp b/Client/qtTeamTalk/mainwindow.cpp
index ebefd89..34b91c9 100644
--- a/Client/qtTeamTalk/mainwindow.cpp
+++ b/Client/qtTeamTalk/mainwindow.cpp
@@ -91,6 +91,10 @@
 
 #include <functional>
 #include <algorithm>
+
+#if defined(TTCENTRAL)
+#include "ttcentral_integration.h"
+#endif
 using namespace std::placeholders;
 
 extern TTInstance* ttInst;
@@ -195,6 +199,9 @@ MainWindow::MainWindow(const QString& cfgfile)
     }
 
     ui.setupUi(this);
+#if defined(TTCENTRAL)
+    ttcentral::install(this, ui.menubar);
+#endif
     setupChatHistory();
 
     setWindowIcon(QIcon(APPICON));
@@ -1815,6 +1822,9 @@ void MainWindow::clienteventSoundDeviceRemoved(const SoundDevice& snddev)
 
 void MainWindow::processTTMessage(const TTMessage& msg)
 {
+#if defined(TTCENTRAL)
+    ttcentral::onClientMessage(msg);
+#endif
     switch (msg.nClientEvent)
     {
     case CLIENTEVENT_CON_SUCCESS :
@@ -7875,6 +7885,11 @@ void MainWindow::slotSoftwareUpdateReply(QNetworkReply* reply, bool manualCheck)
     {
         QString version = newVersionAvailable(doc);
         QString betaVersion = newBetaVersionAvailable(doc);
+#if defined(TTCENTRAL)
+        // TT Central is not updated through BearWare's TeamTalk update channel.
+        version.clear();
+        betaVersion.clear();
+#endif
         if(version.size() || betaVersion.size())
         {
             updateFound = true;
@@ -7931,7 +7946,11 @@ void MainWindow::slotSoftwareUpdateReply(QNetworkReply* reply, bool manualCheck)
     }
     if(!updateFound && manualCheck)
     {
+#if defined(TTCENTRAL)
+        QMessageBox::information(this, tr("Check for Update"), tr("TT Central releases are published at %1").arg(APPWEBSITE));
+#else
         QMessageBox::information(this, tr("Check for Update"), tr("%1 is up to date.").arg(APPNAME_SHORT));
+#endif
     }
     reply->manager()->deleteLater();
 }
